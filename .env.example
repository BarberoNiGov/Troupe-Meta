LLM_PROVIDER=openrouter

# Muse Spark 1.3 Contributor. Requires "paid model training" enabled in
# OpenRouter -> Settings -> Privacy. Use meta/muse-spark-1.3 if it is off.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor

# Muse Spark takes 36-71s per agent; do not leave this at 75s.
LLM_TIMEOUT_SECONDS=600
LLM_MAX_TOKENS=48000

META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Cast and concurrency
MAX_CAST=8
MAX_CONCURRENCY=6

# Cost estimates, USD per 1M tokens. Used only when the provider does not
# report a cost. OpenRouter reports cost directly.
OPENROUTER_INPUT_PRICE_PER_M=0.10
OPENROUTER_OUTPUT_PRICE_PER_M=0.20
META_INPUT_PRICE_PER_M=
META_OUTPUT_PRICE_PER_M=
